# lx-agent configuration
canvas:
  url: "myetl.snu.ac.kr"            # Canvas LMS base URL (was learningx.snu.ac.kr)
  token: ""                          # API access token (Settings → New Access Token)
  session_cookie: ""                 # Alternative: Normandy session cookie (for instances that reject Bearer tokens)

monitor:
  poll_interval: "10m"               # How often to check for updates
  summarize_new: false               # Reserved (no built-in summarizer provider)
  deadline_alerts: [3, 1, 0]         # Alert N days before due date
  state_path: "lx-state.json"        # State file for tracking seen items
  # courses: [12345, 67890]          # Filter specific course IDs (empty = all)

summary:                             # optional: summarise each run's new files
  command: ""                        # e.g. "~/.local/bin/grok -p" (LX_SUMMARY_COMMAND);
                                     # empty disables and the plain file list is sent
  timeout: "3m"

archive:
  dir: "~/etl-archive"               # Where `lx-agent sync` stacks course files.
                                     # Keep this OUT of ~/Documents, ~/Desktop and
                                     # ~/Downloads: macOS TCC makes a headless
                                     # launchd job block forever in open() waiting
                                     # for a consent dialog nobody will ever see.
  max_file_mb: 0                     # Skip files larger than this (0 = no limit)
  include_videos: false              # Lecture video/audio files are big; opt in explicitly
  concurrency: 3                     # Parallel downloads
  # courses: [12345, 67890]          # Restrict the archive to these course IDs
                                     # 강의계획서 is fetched too (sugang.snu.ac.kr);
                                     # disable with `sync --no-syllabus`;
                                     # your own submissions + grades are archived
                                     # too — disable with `sync --no-submissions`
  # homepages:                       # course ID → website; empty = parse
  #   305829: "https://csl.snu.ac.kr/courses/4190.307/2026-2/"
                                     # "과목 홈페이지" from the syllabus. Some
                                     # instructors (운영체제) put slides there,
                                     # not in Canvas. Disable with
                                     # `sync --no-homepage`.

notifier:
  provider: "stdout"                 # stdout | hooker | telegram
  hooker:                            # alerts via hooker -> Telegram
    url: ""                          # HOOKER_URL (env override; keep secrets out of this file)
    api_key: ""                      # HOOKER_API_KEY
    topic: "learningx"
    chat_id: ""                      # e.g. "-1003805075491"
    message_thread_id: ""            # forum thread, e.g. "200238"
  telegram:
    bot_token: ""                    # Telegram bot token from @BotFather
    chat_id: ""                      # Optional: if empty, lookup from database by canvas token

database:
  url: ""                            # Optional: Postgres URL for canvas-token -> chat-id binding
